            "resumido": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "memoria_registrar",
        "description": "Grave um fato explícito com evidência e revisão atual. Reutilize chave; correção usa corrige_anterior. Vários fatos: use lote.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "grupo": {
              "type": "string",
              "enum": [
                "perfil",
                "preferencias",
                "equipamentos",
                "habilidades",
                "operacao",
                "restricoes",
                "financeiro",
                "decisoes",
                "receitas"
              ]
            },
            "chave": {
              "type": "string",
              "description": "Identificador estável snake_case; reutilizar em correções."
            },
            "valor_json": {
              "type": [
                "string",
                "boolean",
                "number",
                "object",
                "array",
                "null"
              ],
              "description": "Prefira JSON NATIVO: false, true, 4, {\"bocas\":4}, ou uma lista. Compatibilidade: uma string é interpretada como JSON serializado; texto deve conter aspas JSON, por exemplo \"\"sem forno\"\". Use null para desconhecido/revogado."
            },
            "status": {
              "type": "string",
              "enum": [
                "confirmado",
                "desconhecido",
                "revogado"
              ]
            },
            "fonte": {
              "type": "string",
              "enum": [
                "dona_maria",
                "usuario_projeto"
              ]
            },
            "evidencia": {
              "type": "string",
              "description": "Trecho explícito da mensagem de quem informou o fato."
            },
            "revisao_esperada": {
              "type": "integer",
              "minimum": 0
            },
            "corrige_anterior": {
              "type": "boolean"
            },
            "sessao": {
              "type": "string"
            }
          },
          "required": [
            "grupo",
            "chave",
            "valor_json",
            "status",
            "fonte",
            "evidencia",
            "revisao_esperada"
          ],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
