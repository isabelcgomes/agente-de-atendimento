NbsSDUPCODowmOSb98b4z3xaP3j4kTil9RFXl9ClF3Fpf1hmwT6No.EaEKYFqbWYWmheJadgS2TDC_oBv2c51FzxGU55hCiBw&amp;amp;dib_tag=se&amp;amp;keywords=kitkat+spreads&amp;amp;qid=1785264722&amp;amp;rnid=15137643011&amp;amp;sprefix=kitkat+spr%2Caps%2C222&amp;amp;sr=8-1" target="_blank" aria-label="" data-title=""><picture style="--ratio-mobile:500/367;--ratio-desktop:905/372;"><source media="(max-width: 991px)" srcset="/sites/default/files/styles/webp/public/2026-07/kitkat-mobile.jpg.webp?itok=csWd8HEr" type="image/webp"/><source media="(max-width: 991px)" srcset="/sites/default/files/2026-07/kitkat-mobile.jpg" type="image/jpeg"/><source media="(min-width: 992px)" srcset="/sites/default/files/styles/webp/public/2026-07/kitkat-desk.jpg.webp?itok=d9B6npsH" type="image/webp"/><source media="(min-width: 992px)" srcset="/sites/default/files/2026-07/kitkat-desk.jpg" type="image/jpeg"/><img src="/sites/default/files/styles/webp/public/2026-07/kitkat-mobile.jpg.webp?itok=csWd8HEr" alt="Banner KitKat em fundo vermelho, com cupom RN15OFF, desconto de 15% e creme KitKat ao lado de uma fatia de bolo." title="" width="500" height="367" loading="lazy" fetchpriority="low"/></picture></a></div><div class="glide__slide"><a href="https://www.nescafe-dolcegusto.com.br" target="_blank" aria-label="" data-title=""><picture style="--ratio-mobile:500/367;--ratio-desktop:905/372;"><source media="(max-width: 991px)" srcset="/sites/default/files/styles/webp/public/2026-07/NDG-mobile.jpg.webp?itok=y3di4dW2" type="image/webp"/><source media="(max-width: 991px)" srcset="/sites/default/files/2026-07/NDG-mobile.jpg" type="image/jpeg"/><source media="(min-width: 992px)" srcset="/sites/default/files/styles/webp/public/2026-07/NDG-desk.jpg.webp?itok=fAdKF6Kf" type="image/webp"/><source media="(min-width: 992px)" srcset="/sites/default/files/2026-07/NDG-desk.jpg" type="image/jpeg"/><img src="/sites/default/files/styles/webp/public/2026-07/NDG-mobile.jpg.webp?itok=y3di4dW2" alt="Banner NESCAFÉ Dolce Gusto com bebidas geladas, desconto de 10% na primeira compra e cupom DOLCERECEITA10." title="" width="500" height="367" loading="lazy" fetchpriority="low"/></picture></a></div><div class="glide__slide"><a href="https://whatsapp.com/channel/0029Vb7jBxUEgGfK9RgirN0B" target="_blank" aria-label="Receitas Nestlé no WhatsApp" data-title="Receitas Nestlé no WhatsApp"><picture style="--ratio-mobile:500/367;--ratio-desktop:905/372;"><source media="(max-width: 991px)" srcset="/sites/default/files/styles/webp/public/2025-07/BR_pt_RECIPES_BannerComunidadeWhats_500x367_M-1_0.jpg.webp?itok=YbZ787V8" type="image/webp"/><source media="(max-width: 991px)" srcset="/sites/default/files/2025-07/BR_pt_RECIPES_BannerComunidadeWhats_500x367_M-1_0.jpg" type="image/jpeg"/><source media="(min-width: 992px)" srcset="/sites/default/files/styles/webp/public/2025-07/BR_pt_RECIPES_BannerComunidadeWhats_905x372_M-1.jpg.webp?itok=tkMG4SOZ" type="image/webp"/><source media="(min-width: 992px)" srcset="/sites/default/files/2025-07/BR_pt_RECIPES_BannerComunidadeWhats_905x372_M-1.jpg" type="image/jpeg"/><img src="/sites/default/files/styles/webp/public/2025-07/BR_pt_RECIPES_BannerComunidadeWhats_500x367_M-1_0.jpg.webp?itok=YbZ787V8" alt="Banner colorido em vermelho e amarelo com celular, legumes e convite para seguir o canal de Receitas Nestlé no WhatsApp" title="Receitas Nestlé no WhatsApp" width="500" height="367" loading="lazy" fetchpriority="low"/></picture></a></div></div></div></div></div></div></section><div id="cook" class="cookSteps mb-5"><h2 class="hl-2 mb-3 c-b">Modo de Preparo</h2><div class="cookSteps__item"><ul><li> <span class="text"><strong class="mr-1">1.</strong>Em uma frigideira grande, derreta a manteiga em fogo alto. </span></li><li> <span class="text"><strong class="mr-1">2.</strong>Refogue a cebola muito bem até que fique mais transparente. Em seguida adicione o frango e deixe dourar um pouco. </span></li><li> <span class="text"><strong class="mr-1">3.</strong>Tempere com o MAGGI Meu Segredo Frango e a pimenta, misturando para que o tempero seja absorvido. Importante: não fique mexendo muito para que o frango não solte ainda mais líquido e isso faça com que o processo demore mais. </span></li><li> <span class="text"><strong class="mr-1">4.</strong>No momento de flambar (opcional), despeje o conhaque, espere aquecer e incline levemente a frigideira para flambar o conhaque. Aguarde acabar a chama. </span></li><li> <span class="text"><strong class="mr-1">5.</strong>Junte os champignons, tampe a frigideira e deixe por alguns minutos. </span></li><li> <span class="text"><strong class="mr-1">6.</strong>Acrescente o purê de tomate, a mostarda e o ketchup, misture bem. Abaixe o fogo, deixe por cerca de 5 minutos, com a frigideira tampada. </span></li><li> <span class="text"><strong class="mr-1">7.</strong>Incorpore delicadamente o NESTLÉ Creme de Leite e retire do fogo antes de ferver. </span></li><li> <span class="text"><strong class="mr-1">8.</strong>Sirva quente com arroz branco e batata palha. </span></li></ul></div></div> <button type="button" class="preferred-sources preferred-sources--recipe cta mb-5 mx-auto" data-preferred-source="recipe" data-lang="pt-BR" data-url="https://www.google.com/preferences/source?q=https://www.receitasnestle.com.br">Adicione Receitas Nestlé como fonte preferida no Google</button><section class="recipe__tips mb-4"><div class="recipe__tipItem recipe__tipItem--alert"><div class="image"> <i class="svg svg-nutrition"></i></div><div class="content"><div class="text"><h2 class="recipe__tipItem--title"> Dicas especiais</h2><p><p>Atente-se na escolha do tempero MAGGI! Nesta receita usamos o MAGGI® Meu Segredo Frango, que já combina os temperos ideais para realçar o sabor do frango sem precisar de sal extra.</p><p><br>Se preferir adaptar com outros produtos da linha MAGGI, o Caldo de Galinha funciona bem para strogonoff de frango, o Caldo de Carne para a versão bovina, e o Caldo de Legumes para o strogonoff de camarão ou vegetariano.</p></p></div><div class="text"><h2 class="recipe__tipItem--title"> DICA</h2><p><p>- Caso prefira, pule a etapa de flambar e siga todos os outros passos normalmente, pois isso não influenciará na textura final nem aparência do seu Strogonoff.</p></p></div><div class="text"><h2 class="recipe__tipItem--title"> ÚLTIMO PASSO DA SUA RECEITA</h2><p><p>- Você sabia que 97% das embalagens dos produtos Nestlé já são produzidas para serem recicladas?<br />Para mais informações e dicas sobre sustentabilidade, acesse nosso site http://www.nestle.com.br/sustentabilidade</p></p></div><div class="text"><h2 class="recipe__tipItem--title"> Dica de Ingrediente</h2><p><p>Descongele o frango na geladeira e nunca à temperatura ambiente para evitar a proliferação de bactérias.</p></p></div><div class="text"><h2 class="recipe__tipItem--title"> Dica Alimentar</h2><p><p>Experimente assar o frango com pele para obter uma carne mais suculenta, depois retire a pele antes de consumir, se preferir reduzir a ingestão de gordura.</p></p></div><div class="text"><h2 class="recipe__tipItem--title"> Como Armazenar e Congelar Strogonoff de Frango</h2><p><p>O strogonoff de frango dura até <strong>3 dias na geladeira</strong>, armazenado em pote hermético. Para requentar, use fogo baixo em uma panela pequena, mexendo delicadamente, e <strong>não deixe ferver</strong>,&nbsp; o calor excessivo pode talhar o creme de leite e deixar o molho com aparência separada.<br></p><p>Adicione 1 ou 2 colheres de sopa de água ou caldo de frango se o molho estiver muito espesso ao requentar.<br></p><p>Pode congelar?<p>Esta é a pergunta mais frequente nos comentários da receita — e a resposta exige um cuidado importante: <strong>o strogonoff feito com creme de leite não congela bem na versão pronta</strong>. Após descongelamento, o creme de leite tende a talhar e o molho perde a textura aveludada, ficando aguado ou granulado.<br></p><p><strong>A solução para quem quer congelar:</strong> Prepare o strogonoff até o passo 6 (após o purê de tomate, mostarda e ketchup), <strong>sem adicionar o creme de leite</strong>. Congele essa base por até 3 meses.<br></p><p>Na hora de servir, descongele na geladeira, aqueça em fogo baixo e adicione o creme de leite fresco apenas no final, o resultado será igual ao recém-feito.<br></p><p>Como requentar sem talhar<ul><li><p>Retire o strogonoff da geladeira 10 minutos antes de requentar (evita choque térmico)</p></li><li><p>Use fogo baixo, nunca alto</p></li><li><p>Mexa suavemente com uma espátula — nunca com fouet, que incorpora ar e pode separar o molho</p></li><li><p>Se necessário, adicione creme de leite fresco (1 ou 2 colheres) para restaurar a cremosidade</p></li></ul><p><br>Use o excendente em outras receitas&nbsp;&nbsp;<br></p><p>Outra opção prática para usar o frango que sobrou do strogonoff é a <a target="_blank" href="https://www.receitasnestle.com.br/receitas/torta-de-frango-de-liquidificador">torta de frango de liquidificador. &nbsp;</a></p></p></div><div class="text"><h2 class="recipe__tipItem--title"> Erros comuns ao fazer strogonoff de frango</h2><p><p>Adicionar o creme de leite com o fogo ainda ligado é o erro mais frequente. Isso porque a alta temperatura faz a gordura do creme talhar, deixando o molho com aparência granulada e sabor 'cortado'.</p><p>Sempre desligue o fogo antes de incorporar o NESTLÉ Creme de Leite e mexa por 30 segundos para uma textura aveludada uniforme.</p><p>Outro deslize comum é não secar bem os pedaços de frango antes de levar à panela: a água residual cozinha o frango em vez de selar, comprometendo o sabor e a cor dourada característica do prato.</p></p></div></div></div></section><section class="recipe__tips mb-4"><div class="recipe__tipItem recipe__tipItem--success"><div class="image"> <i class="icon svg-chef"></i></div><div class="content"><div class="text"><h2 class="recipe__tipItem--title"> Dica Nutricional</h2><p><p>A carne de frango é uma excelente fonte de proteína magra. Prefira a peitoral de frango sem pele para uma opção mais saudável e menos calórica.</p></p></div></div></div></section> <section class="paragraph--23218041 single-image btnChatNutri mt-7 mb-7" data-country=""><div class="container"> <a href=" #
" target=""> <picture> <source media="(max-width: 991px)" srcset="/sites/default/files/styles/webp/public/2025-07/BR_pt_RECIPES_BannersNovaIDChatNutri_500x367_M-1_0.jpg.webp?itok=__skUE3U" type="image/webp"/> <source media="(max-width: 991px)" srcset="/sites/default/files/2025-07/BR_pt_RECIPES_BannersNovaIDChatNutri_500x367_M-1_0.jpg" type="image/jpeg"/> <source media="(min-width: 992px)" srcset="/sites/default/files/styles/webp/public/2025-07/BR_pt_RECIPES_BannersNovaIDChatNutri_1200x300_M-1_0.jpg.webp?itok=DAviruVT" type="image/webp"/> <source media="(min-width: 992px)" srcset="/sites/default/files/2025-07/BR_pt_RECIPES_BannersNovaIDChatNutri_1200x300_M-1_0.jpg" type="image/jpeg"/> <img src="/sites/default/files/styles/webp/public/2025-07/BR_pt_RECIPES_BannersNovaIDChatNutri_500x367_M-1_0.jpg.webp?itok=__skUE3U" alt="Banner em tons vinho e roxo com nutricionista sorrindo e laranja na mão, promovendo o ChatNutri para tirar dúvidas grátis com" title="" width="500" height="367" loading="lazy" fetchpriority="low" /> </picture> </a></div> </section> <section class="faq"><h2 class="faq__title"><i class="svg svg-faq"></i>Perguntas frequentes</h2><div class="accordion__list"><div class="accordion"><div class="accordion__header"><h3>Qual o melhor corte de frango para strogonoff?</h3> <i class="svg svg-arrow"></i></div><div class="accordion__content"><p><p>O filé de peito (ou filé de frango) em tiras finas é o corte ideal: cozinha rapidamente, absorve bem o tempero e fica macio no molho cremoso.</p><p>Corte as tiras com no máximo 1 cm de espessura e 5 cm de comprimento, tiras muito grossas demoram mais para cozinhar e podem ficar ressecadas por fora antes de cozinhar por dentro.&nbsp;</p></p></div></div><div class="accordion"><div class="accordion__header"><h3>Qual a diferença entre strogonoff e estrogonofe?</h3> <i class="svg svg-arrow"></i></div><div class="accordion__content"><p><p>São a mesma receita, "estrogonofe" é a grafia aportuguesada e "strogonoff" é a transliteração do russo. No Brasil, ambas as grafias são aceitas e usadas. O prato é o mesmo: carne ou frango em molho cremoso com creme de leite, mostarda e ketchup, servido com arroz e batata palha.</p></p></div></div><div class="accordion"><div class="accordion__header"><h3>Posso substituir o champignon por outro ingrediente?</h3> <i class="svg svg-arrow"></i></div><div class="accordion__content"><p><p>Sim! O champignon pode ser substituído por: palmito picado (sabor mais delicado, textura firme, ótima opção), cogumelo shitake ou shimeji (mais intensos em sabor), milho verde em grãos (adocicado, combina bem com o molho cremoso) ou simplesmente omitido, o strogonoff fica igualmente delicioso sem ele.</p></p></div></div></div></section><section class="tagsRecipe"><h2 class="tagsRecipe__title hl-2 c-b mb-4 show-title">Assuntos Relacionados</h2><ul class="tagsRecipe__list"><li class="receita-sem-carne-de-porco"> <a class="tagItem" href="/nossas-receitas/receita-sem-carne-de-porco/tag/25066"> receita sem carne de porco </a></li><li class="receita-sem-peixe"> <a class="tagItem" href="/nossas-receitas/receita-sem-peixe/tag/25065"> receita sem peixe </a></li><li class="receita-sem-crustaceos"> <a class="tagItem" href="/nossas-receitas/receita-sem-crustaceos/tag/25064"> receita sem crustaceos </a></li><li class="receita-sem-ovo"> <a class="tagItem" href="/nossas-receitas/receita-sem-ovo/tag/25050"> receita sem ovo </a></li><li class="meu-segredo"> <a class="tagItem" href="/nossas-receitas/meu-segredo/tag/22912"> meu segredo </a></li><li class="mymenuplan"> <a class="tagItem" href="/nossas-receitas/mymenuplan/tag/22759"> MyMenuPlan </a></li><li class="maggi-meu-segredo"> <a class="tagItem" href="/nossas-receitas/maggi-meu-segredo/tag/14252"> maggi meu segredo </a></li><li class="creme-de-leite"> <a class="tagItem" href="/nossas-receitas/creme-de-leite/tag/14000"> creme de leite </a></li></ul></section></div> <aside class="recipeDetail__sidebar" aria-label="aside-content"> <section class="recipeSection mb-7"><div class="container container--no-padding"><div class="recipeSection__header mb-4"><h2 class="hl-sidebar c-b">4 versões</h2></div><div class="sliders sliders--versions mb-4" data-glide-set="false|false|false|false|1.20|2.20|3|false|12|12|24|true"><div class="glide"><div class="glide__track" data-glide-el="track"><div class="glide__slides"> <a href="/receitas/strogonoff-zero-lactose-molico" class="recipes__card easy glide__slide"><div class="recipes__card--shadow"><div class="image"> <picture> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/e6e5f8438b8e7bd9543a2027f10ec117.webp?itok=LcaXd-zw 1x" type="image/webp" width="400" height="256"/> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/e6e5f8438b8e7bd9543a2027f10ec117.jpg?itok=LcaXd-zw 1x" type="image/jpeg" width="400" height="256"/> <img loading="eager" srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/e6e5f8438b8e7bd9543a2027f10ec117.jpg?itok=LcaXd-zw 1x" width="1200" height="500" src="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/e6e5f8438b8e7bd9543a2027f10ec117.jpg?itok=LcaXd-zw" alt="Fotografia em tons de marrom em uma bancada com uma toalha bege, um prato branco raso grande com detalhes listrados em azul e marrom, com o strogonoff de frango com molho e arroz integral." title="Fotografia em tons de marrom em uma bancada com uma toalha bege, um prato branco raso grande com detalhes listrados em azul e marrom, com o strogonoff de frango com molho e arroz integral." fetchpriority="auto" /> </picture><ul class="infos"><li class="infos-difficulty"> <span class="text text-difficulty"> Fácil </span></li><li class="infos-time"><i aria-hidden="true" class="svg-watch-v3 f-w mr-1"></i><span class="text text-total">45	min</span></li></ul></div><div class="content"><h3 class="name">Strogonoff Zero Lactose Molico</h3><hr><p class="origin"><i aria-hidden="true" class="s