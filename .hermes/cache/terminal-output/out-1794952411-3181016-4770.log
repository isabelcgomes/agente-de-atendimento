:"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-12-18T23:32:07.000000-03:00","datePublished":"2020-12-18T23:32:07.000000-03:00","reviewBody":"Receita maravilhosa.","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-12-14T10:20:10.000000-03:00","datePublished":"2020-12-14T10:20:10.000000-03:00","reviewBody":"J\u00e1 fiz e ficou uma del\u00edcia. Obrigada pela receita.","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-11-27T23:50:49.000000-03:00","datePublished":"2020-11-27T23:50:49.000000-03:00","reviewBody":"Sensacional, del\u00edcia!!!","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-09-16T00:02:06.000000-03:00","datePublished":"2020-09-16T00:02:06.000000-03:00","reviewBody":"Adorooooo!! ??????","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-09-13T09:19:37.000000-03:00","datePublished":"2020-09-13T09:19:37.000000-03:00","reviewBody":"Fiz a receita eu achei maravilhosa e todos gostaram.","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-06-29T09:07:50.000000-03:00","datePublished":"2020-06-29T09:07:50.000000-03:00","reviewBody":"AMEI!!! Obrigada!!!!!!!","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-06-25T10:26:36.000000-03:00","datePublished":"2020-06-25T10:26:36.000000-03:00","reviewBody":"S\u00f3 de ler, j\u00e1 deu vontade de fazer!!!","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-03-29T09:48:55.000000-03:00","datePublished":"2020-03-29T09:48:55.000000-03:00","reviewBody":"Uma del\u00edcia hein","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-03-28T14:03:41.000000-03:00","datePublished":"2020-03-28T14:03:41.000000-03:00","reviewBody":"Aprovada, fiz e ficou maravilhoso ??","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-03-26T16:26:47.000000-03:00","datePublished":"2020-03-26T16:26:47.000000-03:00","reviewBody":"Tenho essa receita h\u00e1 anos, fa\u00e7o de carne e de frango, \u00e9 uma del\u00edcia! Muitas vezes substituo o champignons por azeitonas, essa mudan\u00e7a para azeitona deixou meu strogonoff \u00fanico e delicioso.","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-02-29T15:39:21.000000-03:00","datePublished":"2020-02-29T15:39:21.000000-03:00","reviewBody":"Sim, gostei muito","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-01-22T18:07:16.000000-03:00","datePublished":"2020-01-22T18:07:16.000000-03:00","reviewBody":"\u00d3tima a receita, vou fazer o mais r\u00e1pido poss\u00edvel","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2020-01-19T07:40:39.000000-03:00","datePublished":"2020-01-19T07:40:39.000000-03:00","reviewBody":"Deliciosa ?","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}},{"dateCreated":"2019-12-26T16:49:46.000000-03:00","datePublished":"2019-12-26T16:49:46.000000-03:00","reviewBody":"F\u00e1cil e uma del\u00edcia.","reviewRating":{"@type":"Rating","ratingValue":"4","bestRating":5},"author":{"@type":"Person","name":"An\u00f4nimo"}}]}]}</script><script type="application/ld+json">{"@context": "https://schema.org","@graph": [{"@type": "FAQPage","mainEntity": [{"@type": "Question","name": "Qual o melhor corte de frango para strogonoff?","acceptedAnswer": {"@type": "Answer","text": "O filé de peito (ou filé de frango) em tiras finas é o corte ideal: cozinha rapidamente, absorve bem o tempero e fica macio no molho cremoso.Corte as tiras com no máximo 1 cm de espessura e 5 cm de comprimento, tiras muito grossas demoram mais para cozinhar e podem ficar ressecadas por fora antes de cozinhar por dentro. "}},{"@type": "Question","name": "Qual a diferença entre strogonoff e estrogonofe?","acceptedAnswer": {"@type": "Answer","text": "São a mesma receita, \u0022estrogonofe\u0022 é a grafia aportuguesada e \u0022strogonoff\u0022 é a transliteração do russo. No Brasil, ambas as grafias são aceitas e usadas. O prato é o mesmo: carne ou frango em molho cremoso com creme de leite, mostarda e ketchup, servido com arroz e batata palha."}},{"@type": "Question","name": "Posso substituir o champignon por outro ingrediente?","acceptedAnswer": {"@type": "Answer","text": "Sim! O champignon pode ser substituído por: palmito picado (sabor mais delicado, textura firme, ótima opção), cogumelo shitake ou shimeji (mais intensos em sabor), milho verde em grãos (adocicado, combina bem com o molho cremoso) ou simplesmente omitido, o strogonoff fica igualmente delicioso sem ele."}}]},{"@type": "Recipe","@id": "https://www.receitasnestle.com.br/receitas/strogonoff-de-frango","name": "Strogonoff de Frango Cremoso, Fácil e Rápido","description": "O strogonoff de frango é um dos pratos mais amados da culinária brasileira, cremoso, saboroso e pronto em apenas 30 minutos.Esta receita usa filé de frango em tiras douradas na manteiga, temperadas com MAGGI® Meu Segredo Frango e envolvidas em um molho aveludado feito com NESTLÉ® Creme de Leite, mostarda e ketchup, o equilíbrio certo entre o leve toque ácido e a cremosidade irresistível que todo mundo ama.Com champignon fatiado e a opção de flambar com conhaque para um sabor levemente defumado, este clássico vai à mesa em menos tempo do que parece e agrada a família inteira.Sirva com arroz branco e batata palha para a combinação perfeita.","keywords": "receita sem carne de porco,receita sem peixe,receita sem crustaceos,receita sem ovo,meu segredo,MyMenuPlan,maggi meu segredo,creme de leite,receitas caseiras,estrogonofe de frango,estrogonofe,strogonoff,strogonofe,frango,Jantar,Almoço,Prato Principal,europeu,Local,Dia dos Pais,Dias da semana,Finais de semana,Dia das Mães,Celebração,Dia a Dia,Recebendo Amigos,Sem peixe,Sem crustáceos,Porção de Legumes/Frutas,Source of protein,High in protein,Pouca Açúcar,De outros,Frango,Da panela,Prato principal","recipeYield": "5","recipeCuisine": "europeu,Local","datePublished": "2022-10-07T02:16:14-0300","totalTime": "PT30M","recipeIngredient": ["4 colheres (sopa) de manteiga","2 cebolas picadas","1 kg de filé de frango em tiras finas","3 sachês de Tempero MAGGI® Meu Segredo Frango","1 pitada de pimenta-do-reino moída","meia xícara (chá) de conhaque (opcional para flambar)","200 g de champignons em conserva fatiados","3 colheres (sopa) de purê de tomate","1 colher (sopa) de mostarda","2 colheres (sopa) de ketchup","1 lata de NESTLÉ® Creme de Leite"],"recipeInstructions": [{"@type": "HowToStep","text": "Em uma frigideira grande, derreta a manteiga em fogo alto."},{"@type": "HowToStep","text": "Refogue a cebola muito bem até que fique mais transparente. Em seguida adicione o frango e deixe dourar um pouco."},{"@type": "HowToStep","text": "Tempere com o MAGGI Meu Segredo Frango e a pimenta, misturando para que o tempero seja absorvido. Importante: não fique mexendo muito para que o frango não solte ainda mais líquido e isso faça com que o processo demore mais."},{"@type": "HowToStep","text": "No momento de flambar (opcional), despeje o conhaque, espere aquecer e incline levemente a frigideira para flambar o conhaque. Aguarde acabar a chama."},{"@type": "HowToStep","text": "Junte os champignons, tampe a frigideira e deixe por alguns minutos."},{"@type": "HowToStep","text": "Acrescente o purê de tomate, a mostarda e o ketchup, misture bem. Abaixe o fogo, deixe por cerca de 5 minutos, com a frigideira tampada."},{"@type": "HowToStep","text": "Incorpore delicadamente o NESTLÉ Creme de Leite e retire do fogo antes de ferver."},{"@type": "HowToStep","text": "Sirva quente com arroz branco e batata palha."}],"recipeCategory": "Prato Principal","author": {"@type": "Person","name": "Receitas Nestlé"},"image": {"@type": "ImageObject","representativeOfPage": "True","url": "https://www.receitasnestle.com.br/sites/default/files/srh_recipes/abdd2c3a8f46b3b086d51c0d21d623eb.jpg"},"nutrition": {"@type": "NutritionInformation","calories": "555","carbohydrateContent": "16","fiberContent": "3","proteinContent": "48","sodiumContent": "999","sugarContent": "9","fatContent": "26","saturatedFatContent": "14"},"aggregateRating": {"@type": "AggregateRating","ratingValue": "4.3","ratingCount": "70"},"video": {"@type": "VideoObject","uploadDate": "2022-10-07T02:16:14-03:00","name": "Strogonoff de Frango Cremoso, Fácil e Rápido","description": "O strogonoff de frango é um dos pratos mais amados da culinária brasileira, cremoso, saboroso e pronto em apenas 30 minutos.Esta receita usa filé de frango em tiras douradas na manteiga, temperadas com MAGGI® Meu Segredo Frango e envolvidas em um molho aveludado feito com NESTLÉ® Creme de Leite, mostarda e ketchup, o equilíbrio certo entre o leve toque ácido e a cremosidade irresistível que todo mundo ama.Com champignon fatiado e a opção de flambar com conhaque para um sabor levemente defumado, este clássico vai à mesa em menos tempo do que parece e agrada a família inteira.Sirva com arroz branco e batata palha para a combinação perfeita.","thumbnailUrl": "https://i.ytimg.com/vi/KYC3fYu5q7o/hqdefault.jpg","embedUrl": "https://www.youtube.com/embed/KYC3fYu5q7o"}},{"@type": "WebSite","name": "Receitas Nestlé","url": "https://www.receitasnestle.com.br/","potentialAction": {"@type": "SearchAction","target": {"@type": "EntryPoint","urlTemplate": "https://www.receitasnestle.com.br/busca/resultado?q={search_term_string}"},"query-input": "required name=search_term_string"}}]
}</script><link rel="amphtml" href="https://www.receitasnestle.com.br/receitas/strogonoff-de-frango?amp" /><link rel="preload" as="image" href="https://www.receitasnestle.com.br/sites/default/files/styles/recipe_detail_desktop_new/public/srh_recipes/abdd2c3a8f46b3b086d51c0d21d623eb.jpg?itok=mQBZF0JQ" imagesrcset="https://www.receitasnestle.com.br/sites/default/files/styles/recipe_detail_mobile/public/srh_recipes/abdd2c3a8f46b3b086d51c0d21d623eb.jpg?itok=KvOaHgBN 767w, https://www.receitasnestle.com.br/sites/default/files/styles/recipe_detail_tablet/public/srh_recipes/abdd2c3a8f46b3b086d51c0d21d623eb.jpg?itok=Vt7Up537 1024w, https://www.receitasnestle.com.br/sites/default/files/styles/recipe_detail_desktop_new/public/srh_recipes/abdd2c3a8f46b3b086d51c0d21d623eb.jpg?itok=mQBZF0JQ 1200w" imagesizes="(max-width: 767px) 100vw, (max-width: 1024px) 100vw, 1200px" fetchpriority="high" /><link rel="apple-touch-icon" sizes="180x180" href="/themes/custom/cookit/favico/apple-touch-icon.png?v=new"><link rel="icon" type="image/png" sizes="32x32" href="/themes/custom/cookit/favico/favicon-32x32.png?v=new"><link rel="icon" type="image/png" sizes="16x16" href="/themes/custom/cookit/favico/favicon-16x16.png?v=new"><link rel="shortcut icon" href="/themes/custom/cookit/favico/favicon.ico?v=new"/><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="preconnect" href="https://use.typekit.net"><link rel="preconnect" href="https://p.typekit.net"><base href="https://www.receitasnestle.com.br"><title>Strogonoff de Frango Cremoso, Fácil e Rápido | Receitas Nestlé</title><script>
