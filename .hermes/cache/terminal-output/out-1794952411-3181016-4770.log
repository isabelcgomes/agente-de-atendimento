w"><div class="image"> <picture> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/d3edd934a59ce7f2eb128771de982f22.webp?itok=QOCQkRAY 1x" type="image/webp" width="400" height="256"/> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/d3edd934a59ce7f2eb128771de982f22.jpg?itok=QOCQkRAY 1x" type="image/jpeg" width="400" height="256"/> <img loading="eager" srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/d3edd934a59ce7f2eb128771de982f22.jpg?itok=QOCQkRAY 1x" width="4500" height="3000" src="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/d3edd934a59ce7f2eb128771de982f22.jpg?itok=QOCQkRAY" alt="Fotografia em tons de branco e azul de uma bancada de madeira, prato azul com o estrogonofe, batata palha e arroz branco. Ao lado garfo, ao fundo pano azul, travessa com o estrogonofe e potinho laranja com batata palha." title="Fotografia em tons de branco e azul de uma bancada de madeira, prato azul com o estrogonofe, batata palha e arroz branco. Ao lado garfo, ao fundo pano azul, travessa com o estrogonofe e potinho laranja com batata palha." fetchpriority="auto" /> </picture><ul class="infos"><li class="infos-difficulty"> <span class="text text-difficulty"> Fácil </span></li><li class="infos-time"><i aria-hidden="true" class="svg-watch-v3 f-w mr-1"></i><span class="text text-total">30	min</span></li></ul></div><div class="content"><h3 class="name">Strogonoff Vegetariano</h3><hr><p class="origin"><i aria-hidden="true" class="svg-chef-v3 mr-1"></i><span class="name-origin"> Receitas Nestlé </span></p></div></div></a> <a href="/receitas/estrogonofinho-saboroso" class="recipes__card easy glide__slide"><div class="recipes__card--shadow"><div class="image"> <picture> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/2748666c6b292602ed6d6256f528eb94.webp?itok=3kZ9KgXm 1x" type="image/webp" width="400" height="256"/> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/2748666c6b292602ed6d6256f528eb94.jpg?itok=3kZ9KgXm 1x" type="image/jpeg" width="400" height="256"/> <img loading="eager" srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/2748666c6b292602ed6d6256f528eb94.jpg?itok=3kZ9KgXm 1x" width="5597" height="3731" src="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/2748666c6b292602ed6d6256f528eb94.jpg?itok=3kZ9KgXm" alt="Estrogonofinho-saboroso-receitas-nestle" title="Estrogonofinho-saboroso-receitas-nestle" fetchpriority="auto" /> </picture><ul class="infos"><li class="infos-difficulty"> <span class="text text-difficulty"> Fácil </span></li><li class="infos-time"><i aria-hidden="true" class="svg-watch-v3 f-w mr-1"></i><span class="text text-total">45	min</span></li></ul></div><div class="content"><h3 class="name">Estrogonofinho Saboroso</h3><hr><p class="origin"><i aria-hidden="true" class="svg-chef-v3 mr-1"></i><span class="name-origin">Receitas Nestlé</span></p></div></div></a></div></div></div></div><h2 class="hl-3 c-b mb-4 bold title-send-recipe"> Compartilhe sua receita inesquecível e faça parte da nossa comunidade!</h2><a href="/entrar?destination=/envie-sua-receita" class="cta cta--def1" data-datalayer-ctaclick><i class="svg svg-upload-v3 f-5"></i><span>Envie sua receita</span></a></div></section> <section data-datalayer-reciperecommendations class="recipeSection mb-7"><div class="recipeSection__header mb-4"><h2 class="hl-sidebar c-b"> Receitas relacionadas</h2></div><div class="recipeSection__content"><div class="list list--recipeSidebar"> <a href="/receitas/receita-strogonoff-frango" class="glide__slide cardRecipe--sidebar "><div class="cardRecipe__image"> <picture> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/b049324a98bf44949872a50a0c379f45.webp?itok=QHUBXr21 1x" type="image/webp" width="400" height="256"/> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/b049324a98bf44949872a50a0c379f45.jpeg?itok=QHUBXr21 1x" type="image/jpeg" width="400" height="256"/> <img loading="eager" srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/b049324a98bf44949872a50a0c379f45.jpeg?itok=QHUBXr21 1x" width="5184" height="3456" src="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/b049324a98bf44949872a50a0c379f45.jpeg?itok=QHUBXr21" alt="Fotografia de um recipiente vermelho um pouco fundo com strogonoff de frango com folhas de salsinha por cima. O recipiente está sobre um pano quadriculado preto e branco, apoiado em uma mesa de madeira." title="Fotografia de um recipiente vermelho um pouco fundo com strogonoff de frango com folhas de salsinha por cima. O recipiente está sobre um pano quadriculado preto e branco, apoiado em uma mesa de madeira." fetchpriority="auto" /> </picture></div><ul class="cardRecipe__infos"><li class="infos-difficulty"> <span class="text text-difficulty"> Fácil </span></li><li class="infos-time"><i aria-hidden="true" class="svg-watch-v3 f-w mr-1"></i><span class="text text-total">20	min</span></li></ul><h3 class="cardRecipe__title"> Receita de Strogonoff de Frango</h3> </a> <a href="/receitas/strogonoff-suino" class="glide__slide cardRecipe--sidebar "><div class="cardRecipe__image"> <picture> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/df2f570f31922612ea5312a73aca1f2c.webp?itok=fKGZqO-R 1x" type="image/webp" width="400" height="256"/> <source srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/df2f570f31922612ea5312a73aca1f2c.jpg?itok=fKGZqO-R 1x" type="image/jpeg" width="400" height="256"/> <img loading="eager" srcset="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/df2f570f31922612ea5312a73aca1f2c.jpg?itok=fKGZqO-R 1x" width="4493" height="2996" src="/sites/default/files/styles/cropped_recipe_card_new/public/srh_recipes/df2f5