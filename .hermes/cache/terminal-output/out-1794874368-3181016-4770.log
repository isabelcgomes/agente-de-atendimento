    <div class="recipe-steps-info u-margin-bottom u-align-center gd gd-gap-30 gd-s-3"><div class="recipe-steps-info-item"><svg role="img" aria-label="Chronomètre" class="u-icon u-icon-time" viewbox="0 0 20 24"><g stroke-width="1" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5,14 C19.5,19.247 15.246,23.5 10,23.5 C4.752,23.5 0.5,19.247 0.5,14 C0.5,8.753 4.752,4.5 10,4.5 C15.246,4.5 19.5,8.753 19.5,14 L19.5,14 Z"/><path d="M7,0.5 L13,0.5"/><path d="M16.7168,7.2832 L18.4998,5.5002"/><polyline points="8.5 4.5469 8.5 0.4999 11.5 0.4999 11.5 4.5469"></polyline><path d="M18,5 L19,6"/><path d="M10,14 L5.5,9.5"/></g></svg><span>Modo de preparo : </span>
                <strong>
